#!/usr/bin/env bash
#
# kpxc-agent - command-line client for the KeePassXC browser-integration protocol.
#
# This script owns all protocol logic. It builds action messages with jq, passes
# them through the protocol-agnostic encrypted channel (lib/kpxc_channel.py), and
# formats the decrypted replies for shell/agent consumption. See README.md.
#
set -euo pipefail

# Resolve the script's real location even when it is invoked through a symlink on PATH
# (e.g. ~/.local/bin/kpxc-agent -> .../repo/kpxc-agent). BASH_SOURCE is then the symlink,
# so lib/ must be located next to the *real* file. Prefer GNU `readlink -f`; fall back to
# a portable walk for BSD/macOS where `readlink -f` is unavailable.
_kpxc_resolve() {
    local src real
    if real="$(readlink -f -- "$1" 2>/dev/null)" && [ -n "$real" ]; then
        printf '%s\n' "$real"; return
    fi
    src="$1"
    while [ -L "$src" ]; do
        local dir; dir="$(cd -- "$(dirname -- "$src")" >/dev/null 2>&1 && pwd)"
        src="$(readlink -- "$src")"
        case "$src" in /*) ;; *) src="$dir/$src";; esac
    done
    printf '%s\n' "$src"
}
SCRIPT_DIR="$(cd -- "$(dirname -- "$(_kpxc_resolve "${BASH_SOURCE[0]}")")" >/dev/null 2>&1 && pwd)"
CHANNEL="$SCRIPT_DIR/lib/kpxc_channel.py"
BRIDGE="$SCRIPT_DIR/lib/kpxc_bridge.py"
PY="${KPXC_PYTHON:-python3}"

# Exit codes
EX_USAGE=64      # bad invocation
EX_UNREACH=2     # KeePassXC not reachable / database not opened
EX_DENIED=3      # request refused, cancelled, or locked
EX_NOASSOC=4     # no / invalid association
EX_PROTO=5       # protocol or crypto failure
EX_NOTFOUND=6    # reachable, unlocked and associated, but nothing matched
EX_TIMEOUT=7     # timed out waiting for a database

# Global options (may appear before the subcommand)
SOCKET="${KPXC_SOCKET:-}"       # direct unix-socket path
EXEC="${KPXC_EXEC:-}"           # framed-stdio relay command (e.g. keepassxc-proxy)
PROXY=0                         # --proxy: force a keepassxc-proxy relay (auto-detect binary)
TRIGGER=0
DEBUG="${KPXC_AGENT_DEBUG:-0}"
SOCK_NAME="org.keepassxc.KeePassXC.BrowserServer"

die() { local code="$1"; shift; printf 'kpxc-agent: %s\n' "$*" >&2; exit "$code"; }
need() { command -v "$1" >/dev/null 2>&1; }

# Single-quote a value so it is safe to `eval`/source.
shq() { local s=${1//\'/\'\\\'\'}; printf "'%s'" "$s"; }

# Ensure URL has a scheme; default to https:// for bare hostnames.
normalize_url() { case "$1" in *://*) printf '%s' "$1";; *) printf 'https://%s' "$1";; esac; }

# Hash of the database the current command is talking to; set by resolve_assoc so
# error messages can name the vault ("no entry matches X in database Y"). Must be
# assigned outside a command substitution or the value is lost with the subshell.
ACTIVE_DB_HASH=""

# Non-secret projection of an entries array. An explicit ALLOWLIST, not a blocklist:
# `password`, `totp`, `stringFields` and any field KeePassXC adds in a later version
# can never reach stdout through --json/probe. Secrets leave this tool only through
# --field, which the caller is expected to capture into a shell variable.
ENTRY_META='[.[] | {uuid, name, login, group, expired} | with_entries(select(.value != null))]'

# Print a plaintext message to stderr for --debug with secret-bearing fields masked.
# SKILL.md tells agents to retry with --debug, so this must never echo a password.
dbg_send() {
    [[ "$DEBUG" == 1 ]] || return 0
    local m
    for m in "$@"; do
        printf 'kpxc-agent: send %s\n' \
            "$(jq -c 'if has("password") then .password="***" else . end' <<<"$m" 2>/dev/null || printf '%s' "$m")" >&2
    done
}

# ---- association store ------------------------------------------------------
# Persist associations like the browser keyRing: a JSON map keyed by database
# hash -> {id, idKey, created, lastUsed}. The contents are NOT secret (a public
# idKey plus a connection name), mirroring the extension's unencrypted
# storage.local. This is what makes pairing one-time: later runs reload and reuse
# the stored association via test-associate instead of prompting to re-associate.
store_path() {
    printf '%s/keepassxc-cli-agent/associations.json' "${XDG_CONFIG_HOME:-$HOME/.config}"
}

# store_load <hash> -> prints "id<TAB>idKey" for that database, or nothing.
store_load() {
    local f; f="$(store_path)"
    [[ -f "$f" ]] || return 0
    jq -r --arg h "$1" '(.[$h] // empty) | select(.id and .idKey) | "\(.id)\t\(.idKey)"' \
        "$f" 2>/dev/null || true
}

# store_save <hash> <id> <idKey> -> upsert the entry (atomic write, mode 600).
store_save() {
    local hash="$1" id="$2" key="$3" f dir tmp now cur
    f="$(store_path)"; dir="$(dirname "$f")"
    mkdir -p "$dir" 2>/dev/null || true
    chmod 700 "$dir" 2>/dev/null || true
    now="$(date +%s)"
    cur='{}'; [[ -s "$f" ]] && cur="$(<"$f")"; [[ -n "$cur" ]] || cur='{}'
    tmp="$(mktemp "$dir/.assoc.XXXXXX")" || return 0
    if jq --arg h "$hash" --arg id "$id" --arg key "$key" --argjson now "$now" '
            .[$h] = {id:$id, idKey:$key,
                     created: ((.[$h].created) // $now), lastUsed:$now}' \
            <<<"$cur" >"$tmp" 2>/dev/null; then
        chmod 600 "$tmp" 2>/dev/null || true; mv "$tmp" "$f"
    else
        rm -f "$tmp"
    fi
}

# store_touch <hash> -> bump lastUsed (best-effort; failures are ignored).
store_touch() {
    local hash="$1" f dir tmp now
    f="$(store_path)"; [[ -f "$f" ]] || return 0
    dir="$(dirname "$f")"; now="$(date +%s)"
    tmp="$(mktemp "$dir/.assoc.XXXXXX")" || return 0
    if jq --arg h "$hash" --argjson now "$now" \
            'if has($h) then (.[$h].lastUsed=$now) else . end' "$f" >"$tmp" 2>/dev/null; then
        chmod 600 "$tmp" 2>/dev/null || true; mv "$tmp" "$f"
    else
        rm -f "$tmp"
    fi
}

require_tools() {
    need jq || die "$EX_USAGE" "'jq' not found. Install it: apt install jq | dnf install jq | pacman -S jq | apk add jq"
    need "$PY" || die "$EX_USAGE" "'$PY' (python3) not found."
    [[ -f "$CHANNEL" ]] || die "$EX_PROTO" "channel helper missing: $CHANNEL"
}

# ensure_db_open [unlock] -> prints the open database's hash, or fails (returns 1).
# Mirrors the browser's first per-connection step (get-databasehash). With
# unlock=force-unlock (or the global --trigger-unlock) this is what makes KeePassXC
# reopen and unlock the *last-used database* when it is locked OR not currently
# loaded, popping its unlock dialog. The channel's existing trigger-unlock wait
# then blocks until the database-unlocked broadcast and retries. Without this
# preamble, a request against a closed (no-database) KeePassXC never pops a dialog.
ensure_db_open() {
    local unlock="${1-force-unlock}" reply hash
    reply=$(run_action '{"action":"get-databasehash"}' "$unlock") || return 1
    hash=$(jq -r '.hash // empty' <<<"$reply")
    [[ -n "$hash" ]] || return 1
    printf '%s' "$hash"
}

# do_associate -> pair with the open database; sets+exports KPXC_ASSOC_ID/KEY, sets
# ASSOC_HASH/ASSOC_ID/ASSOC_KEY, and persists to the store. Dies on failure, so it
# must be called directly (never inside a command substitution, which would swallow
# die()'s exit).
do_associate() {
    local idkey inner reply ok id rhash
    idkey=$("$PY" "$CHANNEL" keypair) || die "$EX_PROTO" "key generation failed"
    inner=$(jq -nc --arg idkey "$idkey" '{action:"associate", key:"@CLIENTKEY@", idKey:$idkey}')
    reply=$(run_action "$inner" force-unlock) \
        || die "$EX_UNREACH" "KeePassXC unreachable (running? Browser Integration enabled?)"
    ok=$(jq -r '.success // empty' <<<"$reply")
    id=$(jq -r '.id // empty' <<<"$reply")
    rhash=$(jq -r '.hash // empty' <<<"$reply")
    [[ "$ok" == "true" && -n "$id" ]] \
        || die "$EX_DENIED" "association failed or declined in KeePassXC: $(jq -c . <<<"$reply")"
    store_save "$rhash" "$id" "$idkey"
    ASSOC_HASH="$rhash"; ASSOC_ID="$id"; ASSOC_KEY="$idkey"
    KPXC_ASSOC_ID="$id"; KPXC_ASSOC_KEY="$idkey"; export KPXC_ASSOC_ID KPXC_ASSOC_KEY
}

# resolve_assoc [unlock] -> guarantee an open database and a usable association in
# KPXC_ASSOC_ID/KEY, mirroring the extension's reconnect(): open/unlock the DB, then
# prefer an env override (CI), else the stored association for this DB, else pair
# once and persist. Credential commands call this instead of require_assoc, so a
# saved pairing is reused silently and re-association is never needed.
resolve_assoc() {
    local unlock="${1-force-unlock}" hash row
    hash=$(ensure_db_open "$unlock") \
        || die "$EX_UNREACH" "KeePassXC has no open database (unlock it, or pass --trigger-unlock)."
    ACTIVE_DB_HASH="$hash"
    [[ -n "${KPXC_ASSOC_ID:-}" && -n "${KPXC_ASSOC_KEY:-}" ]] && return 0
    row=$(store_load "$hash")
    if [[ -n "$row" ]]; then
        KPXC_ASSOC_ID=${row%%$'\t'*}; KPXC_ASSOC_KEY=${row#*$'\t'}
        export KPXC_ASSOC_ID KPXC_ASSOC_KEY
        store_touch "$hash" || true
        return 0
    fi
    do_associate
}

# Locate a keepassxc-proxy binary; echoes a single-quoted exec string (or fails).
# Prefers a Windows proxy when run from WSL (to reach a Windows KeePassXC), then a
# local Linux proxy in PATH.
detect_proxy() {
    local pp
    for pp in "${KPXC_WIN_KEEPASSXC:-/mnt/c/Program Files/KeePassXC}/keepassxc-proxy.exe" \
              "/mnt/c/Program Files (x86)/KeePassXC/keepassxc-proxy.exe"; do
        [[ -x "$pp" ]] && { printf "'%s'" "$pp"; return 0; }
    done
    pp="$(command -v keepassxc-proxy 2>/dev/null || true)"
    [[ -n "$pp" ]] && { printf "'%s'" "$pp"; return 0; }
    return 1
}

# Candidate directories for the KeePassXC browser socket, in the same order as
# lib/kpxc_channel.py's resolve_socket -- including the Flatpak sandbox path, whose
# absence here made `doctor` report "socket not found" on Flatpak while every other
# command worked, which is exactly the false negative that pushes an agent into a
# fallback instead of using the vault.
socket_dirs() {
    local b
    for b in "${XDG_RUNTIME_DIR:-}" "${TMPDIR:-}" /tmp; do
        [[ -n "$b" ]] && printf '%s\n' "$b"
    done
    [[ -n "${XDG_RUNTIME_DIR:-}" ]] && printf '%s/app/org.keepassxc.KeePassXC\n' "$XDG_RUNTIME_DIR"
    return 0
}

# Decide the transport when not given explicitly.
resolve_transport() {
    [[ -n "$EXEC" || -n "$SOCKET" ]] && return 0
    if [[ "$PROXY" == 1 ]]; then
        EXEC="$(detect_proxy)" || die "$EX_USAGE" "no keepassxc-proxy found; pass --exec PATH"
        return 0
    fi
    local b
    while IFS= read -r b; do
        [[ -S "$b/$SOCK_NAME" ]] && { SOCKET="$b/$SOCK_NAME"; return 0; }
    done < <(socket_dirs)
    # No local socket (e.g. KeePassXC runs on Windows): fall back to a proxy relay.
    EXEC="$(detect_proxy)" || true
}

# Assemble channel arguments from globals.
channel_cmd() {
    local args=("$PY" "$CHANNEL" channel)
    if [[ -n "$EXEC" ]]; then args+=(--exec "$EXEC")
    elif [[ -n "$SOCKET" ]]; then args+=(--socket "$SOCKET"); fi
    if [[ "$1" == "force-unlock" || "$TRIGGER" == 1 ]]; then args+=(--trigger-unlock); fi
    printf '%s\0' "${args[@]}"
}

# Low-level: pipe stdin (newline-joined inner messages) through one channel
# session; prints one compact JSON reply line per message, in order.
channel_pipe() {
    local unlock="${1:-}"
    local cmd=()
    while IFS= read -r -d '' a; do cmd+=("$a"); done < <(channel_cmd "$unlock")
    "${cmd[@]}"
}

# run_action <inner-json> [force-unlock]  ->  prints the reply JSON.
# For actions that need no association context (associate, lock, hash).
run_action() {
    local inner="$1" unlock="${2:-}"
    dbg_send "$inner"
    printf '%s\n' "$inner" | channel_pipe "$unlock"
}

# run_assoc_action <inner-json> [force-unlock]  ->  prints the action reply JSON.
# KeePassXC validates association per-connection, so credential/database actions
# must be preceded by test-associate on the SAME connection (as the extension does).
# Callers must have already run resolve_assoc. On a failed test-associate this emits
# a synthetic errorCode-10 envelope so the caller's check_reply maps it to EX_NOASSOC
# (dying here would be swallowed by command substitution).
run_assoc_action() {
    local inner="$1" unlock="${2:-force-unlock}"
    local ta out
    ta=$(jq -nc --arg id "$KPXC_ASSOC_ID" --arg key "$KPXC_ASSOC_KEY" \
        '{action:"test-associate", id:$id, key:$key}')
    dbg_send "$ta" "$inner"
    out=$(printf '%s\n%s\n' "$ta" "$inner" | channel_pipe "$unlock") || return 1
    if [[ "$(sed -n 1p <<<"$out" | jq -r '.success // empty')" == "true" ]]; then
        sed -n 2p <<<"$out"
    else
        printf '%s\n' '{"error":"association invalid for the open database (run: kpxc-agent test)","errorCode":"10"}'
    fi
}

# Inspect a decrypted reply; map KeePassXC error codes to exit codes.
# Usage: check_reply <json>  (returns 0 on success, exits otherwise)
check_reply() {
    local reply="$1" ok code err
    ok=$(jq -r '.success // empty' <<<"$reply")
    code=$(jq -r '.errorCode // empty' <<<"$reply")
    err=$(jq -r '.error // empty' <<<"$reply")
    if [[ -n "$code" ]]; then
        case "$code" in
            1)      die "$EX_UNREACH" "database not opened (unlock KeePassXC or use --trigger-unlock)";;
            6)      die "$EX_DENIED"  "action cancelled or denied in KeePassXC";;
            8|9)    die "$EX_NOASSOC" "association failed: ${err:-key not accepted}";;
            10)     die "$EX_NOASSOC" "association key not recognized for this database (re-associate)";;
            *)      die "$EX_DENIED"  "KeePassXC error ${code}: ${err:-unknown}";;
        esac
    fi
    [[ "$ok" == "true" || -z "$ok" ]] || die "$EX_DENIED" "request unsuccessful: ${err:-unknown}"
}

usage() {
    cat <<'EOF'
kpxc-agent - KeePassXC browser-integration protocol for the command line

Usage: kpxc-agent [global options] <command> [args]

Transport (auto-detected: local socket, else keepassxc-proxy; override as needed):
  --socket PATH        Connect directly to a KeePassXC unix socket (env: KPXC_SOCKET)
  --proxy              Relay through keepassxc-proxy (auto-finds the binary; reaches a
                       KeePassXC running on Windows when invoked from WSL)
  --exec CMD           Use CMD's stdio as a framed relay, e.g. a specific
                       keepassxc-proxy path (env: KPXC_EXEC)

Other global options:
  --trigger-unlock     Ask KeePassXC to prompt for unlock if the database is locked
  --debug              Print the plaintext messages being sent (env: KPXC_AGENT_DEBUG=1)
  -h, --help           Show this help

Commands:
  associate                       One-time pairing; prints KPXC_ASSOC_ID / KPXC_ASSOC_KEY exports
  test                            Verify the current association against the open database
  get-logins URL [opts]           Fetch credentials matching URL
      --submit-url URL  --http-auth  --field username|password|name|uuid|totp
      --json            List matches as metadata only (never a password)
      --entry-uuid U    Pick one match by uuid (from a --json listing)
      --index N         Pick the Nth match (0-based)
      --allow-empty     Exit 0 instead of 6 when nothing matches
  probe URL [URL...]              Which URLs match, and what the entries are called
      --json                      (metadata only; the diagnostic for a wrong URL field)
  db-info [--json]                Which database is open (hash, name, pairing state)
  wait-db --changed|--hash H      Block until the right database is open
      [--timeout N] [--interval N]  (defaults: 300s timeout, 2s interval)
  get-totp UUID                   Fetch the current TOTP for an entry
  generate-password               Generate a password using KeePassXC's settings
  set-login URL --username U --password P [--submit-url U] [--group G]
      [--group-uuid X] [--uuid X] Create or update an entry
  groups [--json]                 List database groups
  create-group NAME               Create a new group (or path)
  lock                            Lock the database
  hash                            Print the active database hash
  serve-bridge [--listen ADDR]    Expose local KeePassXC for ssh -R reverse forwarding
                                  (run on the CLIENT; default ADDR 127.0.0.1:19455)
  doctor                          Check prerequisites and socket availability

Pairing is persisted per database in ~/.config/keepassxc-cli-agent/associations.json and
reused automatically. These env vars override it (useful in CI); neither is secret:
  KPXC_ASSOC_ID, KPXC_ASSOC_KEY   Produced by `associate` (public key + connection id)

Exit codes:
  0 success   2 unreachable/not opened   3 refused or cancelled   4 no/bad association
  5 protocol or crypto failure   6 no matching entry   7 timed out   64 bad usage

Example:
  kpxc-agent --trigger-unlock associate            # one-time; needs a click in KeePassXC
  eval "$(kpxc-agent get-logins https://host)"     # sets KPXC_USERNAME / KPXC_PASSWORD
  pw=$(kpxc-agent get-logins https://host --field password)   # capture; never print
EOF
}

# ---- commands ---------------------------------------------------------------

cmd_associate() {
    require_tools
    # Open/unlock the database first (mirrors the browser): this pops the unlock
    # dialog even from a cold tray with no database loaded, so associate then runs
    # against an open database.
    ensure_db_open force-unlock >/dev/null \
        || die "$EX_UNREACH" "KeePassXC has no open database to associate with (unlock it, or pass --trigger-unlock)."
    do_associate  # sets ASSOC_* and persists to the store; dies on failure
    printf '# keepassxc-cli-agent associated with database %s (saved to %s)\n' "$ASSOC_HASH" "$(store_path)"
    printf 'export KPXC_ASSOC_ID=%s\n' "$(shq "$ASSOC_ID")"
    printf 'export KPXC_ASSOC_KEY=%s\n' "$(shq "$ASSOC_KEY")"
}

cmd_test() {
    require_tools
    local hash row inner reply unlock=""
    [[ "$TRIGGER" == 1 ]] && unlock=force-unlock
    hash=$(ensure_db_open "$unlock") \
        || die "$EX_UNREACH" "KeePassXC has no open database (unlock it, or pass --trigger-unlock)."
    if [[ -z "${KPXC_ASSOC_ID:-}" || -z "${KPXC_ASSOC_KEY:-}" ]]; then
        row=$(store_load "$hash")
        [[ -n "$row" ]] || die "$EX_NOASSOC" "no association stored for this database (run: kpxc-agent associate)."
        KPXC_ASSOC_ID=${row%%$'\t'*}; KPXC_ASSOC_KEY=${row#*$'\t'}
    fi
    inner=$(jq -nc --arg id "$KPXC_ASSOC_ID" --arg key "$KPXC_ASSOC_KEY" \
        '{action:"test-associate", id:$id, key:$key}')
    reply=$(run_action "$inner") || die "$EX_UNREACH" "KeePassXC unreachable."
    if [[ "$(jq -r '.success // empty' <<<"$reply")" == "true" ]]; then
        printf 'Association valid (id=%s db=%s)\n' \
            "$(jq -r '.id // ""' <<<"$reply")" "$(jq -r '.hash // ""' <<<"$reply")"
    else
        die "$EX_NOASSOC" "association invalid for the open database: $(jq -c . <<<"$reply")"
    fi
}

emit_entry() { # <suffix> <entry-json>
    local sfx="$1" e="$2"
    printf 'KPXC_USERNAME%s=%s\n' "$sfx" "$(shq "$(jq -r '.login // ""'    <<<"$e")")"
    printf 'KPXC_PASSWORD%s=%s\n' "$sfx" "$(shq "$(jq -r '.password // ""' <<<"$e")")"
    printf 'KPXC_NAME%s=%s\n'     "$sfx" "$(shq "$(jq -r '.name // ""'     <<<"$e")")"
    printf 'KPXC_UUID%s=%s\n'     "$sfx" "$(shq "$(jq -r '.uuid // ""'     <<<"$e")")"
}

# fetch_logins <url> [submit-url] [http-auth] -> prints the reply JSON.
# errorCode 15 ("no logins found") is normalized into an empty entries list so callers
# handle "no match" in one place; every other error is left for the caller's check_reply.
fetch_logins() {
    local url="$1" submit="${2:-}" httpauth="${3:-}" inner reply
    inner=$(jq -nc --arg url "$url" --arg sub "$submit" --arg ha "$httpauth" \
        --arg id "$KPXC_ASSOC_ID" --arg key "$KPXC_ASSOC_KEY" '
        {action:"get-logins", id:$id, url:$url, keys:[{id:$id, key:$key}]}
        | (if $sub != "" then .submitUrl=$sub else . end)
        | (if $ha  != "" then .httpAuth=$ha  else . end)')
    reply=$(run_assoc_action "$inner") || die "$EX_UNREACH" "KeePassXC unreachable."
    if [[ "$(jq -r '.errorCode // empty' <<<"$reply")" == "15" ]]; then
        printf '%s' '{"success":"true","entries":[]}'
        return 0
    fi
    printf '%s' "$reply"
}

# A miss is a hard, named failure - never a silent empty result. An agent that gets
# exit 0 and an empty string cannot tell "no such entry" from "empty password", and
# falls back to inventing a secret. Name the vault that was searched and point at the
# two commands that distinguish the two possible causes.
die_no_match() {
    die "$EX_NOTFOUND" "no entry matches $1 in the open database (db ${ACTIVE_DB_HASH:0:12}). Either the wrong vault is open, or the entry's URL field differs. Diagnose with: kpxc-agent db-info | kpxc-agent probe $1 <url-variants>"
}

cmd_get_logins() {
    local url="" submit="" httpauth="" field="" want_json=0
    local sel_uuid="" sel_index="" allow_empty=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --submit-url) submit="${2:?}"; shift 2;;
            --http-auth)  httpauth="true"; shift;;
            --field)      field="${2:?}"; shift 2;;
            --json)       want_json=1; shift;;
            --entry-uuid) sel_uuid="${2:?}"; shift 2;;
            --index)      sel_index="${2:?}"; shift 2;;
            --allow-empty) allow_empty=1; shift;;
            -*)           die "$EX_USAGE" "get-logins: unknown option $1";;
            *)            url="$1"; shift;;
        esac
    done
    [[ -n "$url" ]] || die "$EX_USAGE" "get-logins: URL required"
    url=$(normalize_url "$url")
    case "$field" in
        ""|username|password|name|uuid|totp) ;;
        *) die "$EX_USAGE" "get-logins: unknown --field '$field' (use username|password|name|uuid|totp)";;
    esac
    [[ -z "$sel_uuid" || -z "$sel_index" ]] \
        || die "$EX_USAGE" "get-logins: --entry-uuid and --index are mutually exclusive"
    [[ -z "$sel_index" || "$sel_index" =~ ^[0-9]+$ ]] \
        || die "$EX_USAGE" "get-logins: --index must be a non-negative integer"
    require_tools; resolve_assoc
    local reply entries count
    reply=$(fetch_logins "$url" "$submit" "$httpauth")
    check_reply "$reply"
    entries=$(jq -c '.entries // []' <<<"$reply")
    count=$(jq 'length' <<<"$entries")

    if [[ "$count" == 0 && "$allow_empty" != 1 ]]; then
        [[ "$want_json" == 1 ]] && echo "[]"
        die_no_match "$url"
    fi

    # Narrow to one entry when the caller picked it from a previous --json listing.
    if [[ -n "$sel_uuid" ]]; then
        entries=$(jq -c --arg u "$sel_uuid" '[.[] | select(.uuid == $u)]' <<<"$entries")
        [[ "$(jq 'length' <<<"$entries")" != 0 ]] \
            || die "$EX_NOTFOUND" "no entry with uuid '$sel_uuid' among the $count match(es) for $url"
    elif [[ -n "$sel_index" ]]; then
        [[ "$sel_index" -lt "$count" ]] \
            || die "$EX_USAGE" "--index $sel_index out of range ($count match(es) for $url)"
        entries=$(jq -c --argjson i "$sel_index" '[.[$i]]' <<<"$entries")
    fi

    # --json is metadata only (see ENTRY_META): it exists to choose among matches, and
    # can never carry a password. Fetch the chosen one with --field --entry-uuid.
    if [[ "$want_json" == 1 ]]; then jq -c "$ENTRY_META" <<<"$entries"; return 0; fi
    if [[ -n "$field" ]]; then
        local sel
        case "$field" in
            username) sel='.login';;  password) sel='.password';;
            name)     sel='.name';;   uuid)     sel='.uuid';;  totp) sel='.totp';;
        esac
        jq -r ".[0] | (${sel} // \"\")" <<<"$entries"
        return 0
    fi
    count=$(jq 'length' <<<"$entries")
    case "$count" in
        0) return 0;;
        1) emit_entry "" "$(jq -c '.[0]' <<<"$entries")";;
        *) printf 'KPXC_COUNT=%s\n' "$count"
           local i=0
           while [[ $i -lt $count ]]; do emit_entry "_$i" "$(jq -c ".[$i]" <<<"$entries")"; i=$((i+1)); done;;
    esac
}

# probe: which of these URLs actually match something, and what are they called?
# The diagnostic for "the entry's URL field is a typo / an unexpected format". Prints
# entry names and usernames (via ENTRY_META) so the answer can be shown to the user -
# it is the only command in the credential path whose output is safe to display.
cmd_probe() {
    local want_json=0 urls=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) want_json=1; shift;;
            -*)     die "$EX_USAGE" "probe: unknown option $1";;
            *)      urls+=("$(normalize_url "$1")"); shift;;
        esac
    done
    [[ ${#urls[@]} -gt 0 ]] || die "$EX_USAGE" "probe: at least one URL required"
    require_tools; resolve_assoc
    local u reply meta n total=0 out='[]'
    for u in "${urls[@]}"; do
        reply=$(fetch_logins "$u")
        check_reply "$reply"
        meta=$(jq -c "$ENTRY_META" <<<"$(jq -c '.entries // []' <<<"$reply")")
        n=$(jq 'length' <<<"$meta")
        total=$((total + n))
        if [[ "$want_json" == 1 ]]; then
            out=$(jq -c --arg u "$u" --argjson e "$meta" '. + [{url:$u, count:($e|length), entries:$e}]' <<<"$out")
        else
            printf '%s\t%s\t%s\n' "$u" "$n" \
                "$(jq -r 'map("\(.name // "?") (\(.login // ""))") | join(", ")' <<<"$meta")"
        fi
    done
    if [[ "$want_json" == 1 ]]; then printf '%s\n' "$out"; fi
    if [[ "$total" -eq 0 ]]; then
        die "$EX_NOTFOUND" "none of the probed URLs match an entry in the open database (db ${ACTIVE_DB_HASH:0:12}). Check which vault is open (kpxc-agent db-info), or have the user correct the entry's URL field."
    fi
}

cmd_get_totp() {
    local uuid="${1:-}"; [[ -n "$uuid" ]] || die "$EX_USAGE" "get-totp: UUID required"
    require_tools; resolve_assoc
    local inner reply
    inner=$(jq -nc --arg u "$uuid" '{action:"get-totp", uuid:$u}')
    reply=$(run_assoc_action "$inner") || die "$EX_UNREACH" "KeePassXC unreachable."
    check_reply "$reply"
    printf 'KPXC_TOTP=%s\n' "$(shq "$(jq -r '.totp // ""' <<<"$reply")")"
}

cmd_generate_password() {
    require_tools; resolve_assoc
    local inner reply pw
    inner=$(jq -nc --arg rid "$(printf '%08x' $((RANDOM*RANDOM)))" \
        '{action:"generate-password", requestID:$rid}')
    reply=$(run_assoc_action "$inner") || die "$EX_UNREACH" "KeePassXC unreachable."
    check_reply "$reply"
    # KeePassXC returns the generated password under .password (older builds: .entries).
    pw=$(jq -r 'if (.entries|type)=="string" then .entries else (.password // .entries[0].password // "") end' <<<"$reply")
    printf 'KPXC_PASSWORD=%s\n' "$(shq "$pw")"
}

cmd_set_login() {
    local url="" user="" pass="" submit="" group="" guuid="" uuid=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --username)   user="${2:?}"; shift 2;;
            --password)   pass="${2:?}"; shift 2;;
            --submit-url) submit="${2:?}"; shift 2;;
            --group)      group="${2:?}"; shift 2;;
            --group-uuid) guuid="${2:?}"; shift 2;;
            --uuid)       uuid="${2:?}"; shift 2;;
            -*)           die "$EX_USAGE" "set-login: unknown option $1";;
            *)            url="$1"; shift;;
        esac
    done
    [[ -n "$url" && -n "$user" ]] || die "$EX_USAGE" "set-login: URL and --username required"
    url=$(normalize_url "$url")
    require_tools; resolve_assoc
    local inner reply
    inner=$(jq -nc --arg url "$url" --arg sub "${submit:-$url}" --arg id "$KPXC_ASSOC_ID" \
        --arg login "$user" --arg pw "$pass" --arg group "$group" --arg guuid "$guuid" --arg uuid "$uuid" '
        {action:"set-login", id:$id, url:$url, submitUrl:$sub, login:$login, password:$pw}
        | (if $group != "" then .group=$group else . end)
        | (if $guuid != "" then .groupUuid=$guuid else . end)
        | (if $uuid  != "" then .uuid=$uuid else . end)')
    reply=$(run_assoc_action "$inner") || die "$EX_UNREACH" "KeePassXC unreachable."
    check_reply "$reply"
    echo "Saved."
}

cmd_groups() {
    local want_json=0
    [[ "${1:-}" == "--json" ]] && want_json=1
    require_tools; resolve_assoc
    local reply; reply=$(run_assoc_action '{"action":"get-database-groups"}') || die "$EX_UNREACH" "KeePassXC unreachable."
    check_reply "$reply"
    # KeePassXC nests the root groups under .groups.groups (older docs show .groups).
    if [[ "$want_json" == 1 ]]; then jq -c '(.groups.groups // .groups) // []' <<<"$reply"; return 0; fi
    # Print "uuid<TAB>name-path" for each group, depth-first.
    jq -r '
        def walk($prefix):
            ($prefix + .name) as $p
            | (.uuid + "\t" + $p),
              (.children[]? | walk($p + "/"));
        (.groups.groups // .groups)[]? | walk("")' <<<"$reply"
}

cmd_create_group() {
    local name="${1:-}"; [[ -n "$name" ]] || die "$EX_USAGE" "create-group: NAME required"
    require_tools; resolve_assoc
    local inner reply
    inner=$(jq -nc --arg n "$name" '{action:"create-new-group", groupName:$n}')
    reply=$(run_assoc_action "$inner") || die "$EX_UNREACH" "KeePassXC unreachable."
    check_reply "$reply"
    printf '%s\t%s\n' "$(jq -r '.uuid // ""' <<<"$reply")" "$(jq -r '.name // ""' <<<"$reply")"
}

cmd_lock() {
    require_tools
    local reply; reply=$(run_action '{"action":"lock-database"}') || die "$EX_UNREACH" "KeePassXC unreachable."
    # lock-database replies with an error envelope by design; treat reaching it as success.
    echo "Lock requested."
}

cmd_hash() {
    require_tools
    local reply; reply=$(run_action '{"action":"get-databasehash"}' ) || die "$EX_UNREACH" "KeePassXC unreachable."
    check_reply "$reply"
    jq -r '.hash // ""' <<<"$reply"
}

# serve-bridge: expose the local KeePassXC transport as a listening endpoint so it
# can be reverse-forwarded over ssh (`ssh -R`) to a remote box. Run this on the
# CLIENT (where KeePassXC lives); the box then uses `kpxc-agent --socket <forwarded>`.
# Reuses the already-resolved transport (SOCKET or EXEC), so it works the same on a
# Linux/macOS client (relays the unix socket) and a Windows/WSL client (relays
# keepassxc-proxy.exe). Listens on 127.0.0.1:19455 by default (a `ssh -R` can map a
# box-side unix socket onto it on any client OS); override with --listen.
cmd_serve_bridge() {
    require_tools
    [[ -f "$BRIDGE" ]] || die "$EX_PROTO" "bridge helper missing: $BRIDGE"
    local listen="127.0.0.1:19455"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --listen) listen="${2:?}"; shift 2;;
            -*)       die "$EX_USAGE" "serve-bridge: unknown option $1";;
            *)        die "$EX_USAGE" "serve-bridge: unexpected argument '$1'";;
        esac
    done
    local args=("$PY" "$BRIDGE" --listen "$listen")
    if [[ -n "$EXEC" ]]; then args+=(--exec "$EXEC")
    elif [[ -n "$SOCKET" ]]; then args+=(--socket "$SOCKET")
    else die "$EX_UNREACH" "no local KeePassXC transport found (start KeePassXC, or pass --socket/--exec/--proxy)"; fi
    exec "${args[@]}"
}

# db-info: which vault am I actually talking to? The browser protocol exposes no
# database name, so identity is the hash plus the ROOT GROUP name -- KeePassXC names
# the root group after the database, making it the only human-recognizable label
# available. Everything printed here is non-secret.
cmd_db_info() {
    local want_json=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) want_json=1; shift;;
            -*)     die "$EX_USAGE" "db-info: unknown option $1";;
            *)      die "$EX_USAGE" "db-info: unexpected argument '$1'";;
        esac
    done
    require_tools
    local unlock="" hash state paired root="" row reply
    # Do not force unlock: a diagnostic must be able to report "locked" rather than
    # popping a dialog the caller did not ask for. --trigger-unlock still works.
    [[ "$TRIGGER" == 1 ]] && unlock=force-unlock
    hash=$(ensure_db_open "$unlock") || hash=""
    if [[ -z "$hash" ]]; then
        state="closed-or-locked"; paired="unknown"
    else
        state="open"
        # Reuse a pairing if we already have one, but never pair from a diagnostic:
        # do_associate would pop an approval dialog as a side effect of asking a question.
        if [[ -n "${KPXC_ASSOC_ID:-}" && -n "${KPXC_ASSOC_KEY:-}" ]]; then
            paired="yes (KPXC_ASSOC_* env)"
        else
            row=$(store_load "$hash")
            if [[ -n "$row" ]]; then
                KPXC_ASSOC_ID=${row%%$'\t'*}; KPXC_ASSOC_KEY=${row#*$'\t'}
                paired="yes (association store)"
            else
                paired="no"
            fi
        fi
        if [[ -n "${KPXC_ASSOC_ID:-}" && -n "${KPXC_ASSOC_KEY:-}" ]]; then
            reply=$(run_assoc_action '{"action":"get-database-groups"}' "") || reply=""
            [[ -n "$reply" ]] \
                && root=$(jq -r '((.groups.groups // .groups) // [])[0].name // ""' <<<"$reply" 2>/dev/null || printf '')
        fi
    fi
    if [[ "$want_json" == 1 ]]; then
        jq -nc --arg s "$state" --arg h "$hash" --arg n "$root" --arg p "$paired" \
            '{state:$s, hash:$h, name:$n, paired:$p}'
    else
        printf 'database: %s\n' "$state"
        printf 'hash:     %s\n' "${hash:-(none)}"
        printf 'name:     %s\n' "${root:-(unknown - root group name unavailable)}"
        printf 'paired:   %s\n' "$paired"
        [[ -n "$hash" ]] \
            || printf 'hint:     no database is open; re-run as `kpxc-agent --trigger-unlock db-info` to pop the unlock dialog (credential commands do this automatically)\n'
    fi
    [[ -n "$hash" ]] || return "$EX_UNREACH"
}

# probe_hash -> the active database hash, or nothing when none is open. Never forces
# unlock: wait-db calls this on every tick and force-unlock would re-pop the unlock
# dialog each time.
probe_hash() {
    local reply
    reply=$(run_action '{"action":"get-databasehash"}' "" 2>/dev/null) || return 0
    jq -r '.hash // empty' <<<"$reply" 2>/dev/null || true
}

# wait-db: block until the user has the right vault open, so a credential lookup can be
# retried instead of the whole task failing. Polls rather than waiting on the
# database-unlocked broadcast, because switching between two ALREADY-unlocked databases
# emits no signal at all - and that switch is the case this exists for.
cmd_wait_db() {
    local target="" changed=0 timeout=300 interval=2
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --hash)     target="${2:?}"; shift 2;;
            --changed)  changed=1; shift;;
            --timeout)  timeout="${2:?}"; shift 2;;
            --interval) interval="${2:?}"; shift 2;;
            -*)         die "$EX_USAGE" "wait-db: unknown option $1";;
            *)          die "$EX_USAGE" "wait-db: unexpected argument '$1'";;
        esac
    done
    [[ -n "$target" || "$changed" == 1 ]] \
        || die "$EX_USAGE" "wait-db: pass --hash HASH or --changed"
    [[ "$timeout" =~ ^[0-9]+$ && "$interval" =~ ^[0-9]+$ && "$interval" -gt 0 ]] \
        || die "$EX_USAGE" "wait-db: --timeout/--interval must be integers (--interval > 0)"
    require_tools
    local baseline hash what deadline=$((SECONDS + timeout)) noted=$SECONDS
    baseline=$(probe_hash)
    if [[ -n "$target" ]]; then what="database $target"
    elif [[ -n "$baseline" ]]; then what="a database other than ${baseline:0:12}"
    else what="any database to be opened"; fi
    while :; do
        hash=$(probe_hash)
        if [[ -n "$hash" ]]; then
            if [[ -n "$target" ]]; then
                [[ "$hash" == "$target" ]] && { printf '%s\n' "$hash"; return 0; }
            elif [[ -z "$baseline" || "$hash" != "$baseline" ]]; then
                printf '%s\n' "$hash"; return 0
            fi
        fi
        [[ $SECONDS -lt $deadline ]] || break
        if [[ $((SECONDS - noted)) -ge 30 ]]; then
            printf 'kpxc-agent: still waiting for %s (%ss left)\n' "$what" "$((deadline - SECONDS))" >&2
            noted=$SECONDS
        fi
        sleep "$interval"
    done
    die "$EX_TIMEOUT" "timed out after ${timeout}s waiting for $what"
}

cmd_doctor() {
    local ok=0 reply
    printf 'keepassxc-cli-agent doctor\n'
    if need jq; then printf '  [ok]   jq: %s\n' "$(command -v jq)"; else
        printf '  [MISS] jq  -> apt install jq | dnf install jq | pacman -S jq | apk add jq\n'; ok=1; fi
    if need "$PY"; then printf '  [ok]   python3: %s\n' "$(command -v "$PY")"; else
        printf '  [MISS] python3\n'; ok=1; fi
    if "$PY" "$CHANNEL" keypair >/dev/null 2>&1; then printf '  [ok]   libsodium loadable via ctypes\n'; else
        printf '  [MISS] libsodium -> apt install libsodium23 | dnf install libsodium | pacman -S libsodium | apk add libsodium\n'; ok=1; fi
    # Report the transport and probe reachability.
    if [[ -n "$EXEC" ]]; then
        printf '  [info] transport: relay (%s)\n' "$EXEC"
        if reply=$(run_action '{"action":"get-databasehash"}' 2>/dev/null) && [[ -n "$reply" ]]; then
            printf '  [ok]   KeePassXC reachable through relay (db %s)\n' "$(jq -r '.hash // "?"' <<<"$reply" 2>/dev/null)"
        else
            printf '  [warn] relay set but KeePassXC did not respond (running? pipe name correct?)\n'
        fi
    else
        local sp="${SOCKET:-}"
        if [[ -z "$sp" ]]; then
            while IFS= read -r b; do
                [[ -S "$b/$SOCK_NAME" ]] && { sp="$b/$SOCK_NAME"; break; }
            done < <(socket_dirs)
        fi
        if [[ -n "$sp" && -S "$sp" ]]; then printf '  [ok]   socket: %s\n' "$sp"; else
            printf '  [warn] KeePassXC socket not found (start KeePassXC and enable Browser Integration)\n'; fi
    fi
    [[ -n "${KPXC_ASSOC_ID:-}" && -n "${KPXC_ASSOC_KEY:-}" ]] \
        && printf '  [ok]   association vars present (KPXC_ASSOC_ID/KEY override the store)\n' \
        || printf '  [info] no KPXC_ASSOC_ID/KEY in env (using the persisted store, if any)\n'
    if [[ -f "$(store_path)" ]] && need jq; then
        printf '  [ok]   association store: %s (%s saved)\n' \
            "$(store_path)" "$(jq 'length' "$(store_path)" 2>/dev/null || printf '?')"
    else
        printf '  [info] no association store yet (created on first associate: %s)\n' "$(store_path)"
    fi
    return $ok
}

# ---- dispatch ---------------------------------------------------------------

while [[ $# -gt 0 ]]; do
    case "$1" in
        --socket)         SOCKET="${2:?}"; shift 2;;
        --exec)           EXEC="${2:?}"; shift 2;;
        --proxy)          PROXY=1; shift;;
        --trigger-unlock) TRIGGER=1; shift;;
        --debug)          DEBUG=1; shift;;
        -h|--help|help)   usage; exit 0;;
        --) shift; break;;
        -*) die "$EX_USAGE" "unknown global option $1";;
        *) break;;
    esac
done

resolve_transport

cmd="${1:-}"; [[ $# -gt 0 ]] && shift || true
case "$cmd" in
    associate)          cmd_associate "$@";;
    test)               cmd_test "$@";;
    get-logins)         cmd_get_logins "$@";;
    probe)              cmd_probe "$@";;
    db-info)            cmd_db_info "$@";;
    wait-db)            cmd_wait_db "$@";;
    get-totp)           cmd_get_totp "$@";;
    generate-password)  cmd_generate_password "$@";;
    set-login)          cmd_set_login "$@";;
    groups)             cmd_groups "$@";;
    create-group)       cmd_create_group "$@";;
    lock)               cmd_lock "$@";;
    hash)               cmd_hash "$@";;
    serve-bridge)       cmd_serve_bridge "$@";;
    doctor)             cmd_doctor "$@";;
    ""|help|-h|--help)  usage; exit 0;;
    *)                  die "$EX_USAGE" "unknown command '$cmd' (try: kpxc-agent --help)";;
esac
